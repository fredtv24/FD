lp.Chatted:Connect(function(msg)
    local cmd = msg:lower()
    if cmd:sub(1,4) == "!fly" then
        local speed = tonumber(cmd:match("!fly%s+(%d+)"))
        if speed then
            flySpeed = math.clamp(speed, 1, 500)
            speedBox.Text = tostring(flySpeed)
        end
        if not FLYING then
            startFly()
            flyBtn.Text = "Fly: ON"
            TweenService:Create(flyBtn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(0,90,160)}):Play()
        end
    elseif cmd == "!unfly" then
        if FLYING then
            stopFly()
            flyBtn.Text = "Fly: OFF"
            TweenService:Create(flyBtn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(0,45,80)}):Play()
        end
    end
end)