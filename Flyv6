local minimized = false
local bubbleSavedPos = nil
local bDrag, bDragStart = false, nil

bubble.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        bDrag = true
        bDragStart = {
            mouse  = i.Position,
            bubble = bubble.Position
        }
    end
end)
bubble.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        bDrag = false
        bubbleSavedPos = bubble.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if bDrag and (i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch) then
        if not bDragStart then return end
        local d = i.Position - bDragStart.mouse
        bubble.Position = UDim2.new(
            0, bDragStart.bubble.X.Offset + d.X,
            0, bDragStart.bubble.Y.Offset + d.Y
        )
    end
end)

minBtn.Activated:Connect(function()
    if minimized then return end
    minimized = true
    if bubbleSavedPos then
        bubble.Position = bubbleSavedPos
    else
        local vp = Camera.ViewportSize
        local ax = frame.Position.X.Scale * vp.X + frame.Position.X.Offset
        local ay = frame.Position.Y.Scale * vp.Y + frame.Position.Y.Offset
        bubble.Position = UDim2.new(0, ax + frame.AbsoluteSize.X/2 - 21, 0, ay + frame.AbsoluteSize.Y/2 - 21)
    end
    frame.Visible = false
    bubble.Visible = true
end)

bubble.Activated:Connect(function()
    if not minimized then return end
    minimized = false
    bubble.Visible = false
    frame.Visible = true
end)

