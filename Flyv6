local function getControlModule()
    local ok, ctrl = pcall(function()
        return require(lp.PlayerScripts:WaitForChild("PlayerModule",3):WaitForChild("ControlModule",3))
    end)
    if ok and ctrl then return ctrl end
end
local ctrlModule = getControlModule()

local function GetMoveVector()
    if ctrlModule then
        local ok, vec = pcall(function() return ctrlModule:GetMoveVector() end)
        if ok and typeof(vec) == "Vector3" and vec.Magnitude > 0 then return vec end
    end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.MoveDirection.Magnitude > 0 then return hum.MoveDirection end
    return Vector3.zero
end

local function startFly()
    local char = lp.Character or lp.CharacterAdded:Wait()
    if flyMobile then flyMobile:Destroy() end
    flyMobile = Instance.new("Part", workspace)
    flyMobile.Size = Vector3.new(0.05,0.05,0.05)
    flyMobile.CanCollide = false; flyMobile.Transparency = 1
    flyMobile.Anchored = false; flyMobile.Massless = true
    if MobileWeld then MobileWeld:Destroy() end
    MobileWeld = Instance.new("Weld", flyMobile)
    MobileWeld.Part0 = flyMobile
    MobileWeld.Part1 = char:FindFirstChildWhichIsA("Humanoid").RootPart
    MobileWeld.C0 = CFrame.new(0,0,0)
    local bv = Instance.new("BodyVelocity", flyMobile)
    bv.MaxForce = Vector3.new(0,0,0); bv.Velocity = Vector3.new(0,0,0)
    local bg = Instance.new("BodyGyro", flyMobile)
    bg.MaxTorque = Vector3.new(9e9,9e9,9e9); bg.P = 1000; bg.D = 50
    if FlySignal1 then FlySignal1:Disconnect() end
    FlySignal1 = lp.CharacterAdded:Connect(function(newChar)
        MobileWeld.Part0 = flyMobile
        MobileWeld.Part1 = newChar:FindFirstChildWhichIsA("Humanoid").RootPart
        MobileWeld.C0 = CFrame.new(0,0,0)
    end)
    if FlySignal2 then FlySignal2:Disconnect() end
    FlySignal2 = RunService.RenderStepped:Connect(function()
        local char2 = lp.Character
        local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
        local bv2 = flyMobile and flyMobile:FindFirstChildWhichIsA("BodyVelocity")
        local bg2 = flyMobile and flyMobile:FindFirstChildWhichIsA("BodyGyro")
        if char2 and hum2 and flyMobile and MobileWeld and bv2 and bg2 then
            bv2.MaxForce = Vector3.new(9e9,9e9,9e9)
            bg2.MaxTorque = Vector3.new(9e9,9e9,9e9)
            hum2.PlatformStand = true
            bg2.CFrame = Camera.CFrame
            local dir = GetMoveVector()
            local vel = Vector3.new()
            if dir.X ~= 0 then vel = vel + Camera.CFrame.RightVector*(dir.X*flySpeed*50) end
            if dir.Z ~= 0 then vel = vel - Camera.CFrame.LookVector*(dir.Z*flySpeed*50) end
            bv2.Velocity = vel
        end
    end)
    FLYING = true
end

local function stopFly()
    if flyMobile then flyMobile:Destroy(); flyMobile = nil end
    if MobileWeld then MobileWeld:Destroy(); MobileWeld = nil end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    if FlySignal1 then FlySignal1:Disconnect(); FlySignal1 = nil end
    if FlySignal2 then FlySignal2:Disconnect(); FlySignal2 = nil end
    FLYING = false
end

local function killSwitch(gui)
    stopFly()
