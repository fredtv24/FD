local waveIndex = 0
task.spawn(function()
    while gui and gui.Parent do
        waveIndex = (waveIndex % #subLetters) + 1
        for i, lbl in ipairs(subLetters) do
            local dist = math.abs(i - waveIndex)
            if dist == 0 then
                TweenService:Create(lbl, TweenInfo.new(0.08), {TextColor3 = Color3.fromRGB(210, 225, 240)}):Play()
            elseif dist == 1 then
                TweenService:Create(lbl, TweenInfo.new(0.12), {TextColor3 = Color3.fromRGB(120, 150, 180)}):Play()
            elseif dist == 2 then
                TweenService:Create(lbl, TweenInfo.new(0.18), {TextColor3 = Color3.fromRGB(70, 105, 140)}):Play()
            else
                TweenService:Create(lbl, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(50, 90, 130)}):Play()
            end
        end
        task.wait(0.09)
    end
end)

local function makeBtn(iconName, offsetX)
    local btn = Instance.new("TextButton", header)
    btn.Size = UDim2.new(0,22,0,22)
    btn.Position = UDim2.new(1, offsetX, 0.5, -11)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.RichText = true
    btn.Text = iconText(iconName)
    btn.TextColor3 = Color3.fromRGB(140,140,180)
    btn.TextSize = 15
    btn.Font = Enum.Font.GothamBold
    btn.ZIndex = 5
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn,TweenInfo.new(0.1),{TextColor3=Color3.fromRGB(0,210,255)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn,TweenInfo.new(0.1),{TextColor3=Color3.fromRGB(140,140,180)}):Play()
    end)
    return btn
end

