  .night-auto .post-form .draft { color: rgb(153, 153, 153); }
  .night-auto .CodeMirror, .night-auto .form-horizontal .form-group .form-control, .night-auto .form-horizontal .whitelist .form-control, .night-auto .textarea { background-color: rgb(43, 43, 43); border: 1px solid rgb(51, 51, 51); color: rgb(221, 221, 221); }
