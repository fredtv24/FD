  .night-auto .select2-container--default.select2-container--focus .select2-selection--multiple { border: 1px solid rgb(0, 0, 0); outline: 0px; }
  .night-auto .select2-container--default .select2-search--dropdown .select2-search__field { border: 1px solid rgb(221, 221, 221); color: rgb(221, 221, 221); background-color: rgb(68, 68, 68); }
