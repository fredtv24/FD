.whitelist input { display: inline; width: 272px; font-size: 1em; margin-right: 5px; }

.whitelist-form .error-summary { font-size: 1em; }

.page-avatar .custom-file-input { vertical-align: top; display: inline-block; position: relative; }

.page-avatar .custom-file-input:hover::before { color: rgb(0, 0, 0); opacity: 0.8; }

.page-avatar .custom-file-input::before { margin: 0px; line-height: 35px; height: 35px; background-color: rgb(221, 221, 221); border-radius: 3px; border-width: 0px 0px 2px; border-top-style: initial; border-right-style: initial; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-left-color: initial; border-image: initial; border-bottom-style: solid; border-bottom-color: rgb(204, 204, 204); color: rgb(0, 0, 0); content: "Choose File"; cursor: pointer; display: block; font-family: "segoe ui", "trebuchet MS", "Lucida Sans Unicode", "Lucida Sans", sans-serif; font-size: 13px; font-weight: 600; left: 0px; min-width: 54px; outline: none; position: absolute; right: 0px; text-align: center; text-decoration: none; white-space: nowrap; padding: 0px 10px; }

.page-avatar .custom-file-input input { visibility: hidden; width: 100px; }

.page-avatar .upload-file-text { background: rgb(255, 255, 255); border: 0px; color: rgb(24, 24, 24); height: 25px; line-height: 25px; width: 300px; overflow: hidden; font-size: 11px; }

.message { margin-right: 6px; }

.message__top { background: rgb(249, 249, 249); border-left: 1px solid rgb(221, 221, 221); border-radius: 3px 3px 0px 0px; border-right: 1px solid rgb(221, 221, 221); border-top: 2px solid rgb(221, 221, 221); color: rgb(51, 51, 51); font-size: 0.7em; text-transform: uppercase; margin: 10px 0px 0px; padding: 4px 8px; }

.message__top span { font-weight: 400; }

.message__top .pro { display: inline-block; background: url("/themes/pastebin/img/pro_btn.png") 0% 0% / 28px 14px no-repeat; height: 14px; width: 28px; vertical-align: middle; margin: -3px 0px 0px; }

.message__top .pro:hover { background: url("/themes/pastebin/img/pro_btn_hover.png") 0% 0% / 28px 14px no-repeat; }

.message__top .pro.-message { margin-left: 6px; }

