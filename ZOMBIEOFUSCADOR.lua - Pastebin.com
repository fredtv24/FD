------MultipartBoundary--rkW4YMVhEKPrlzEYleyKRwwWdSrjR294lt7w33ax6B----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://pastebin.com/themes/pastebin/css/geshi/light/lua.css?694707f98000ed24d865

@charset "utf-8";

.lua .de1, .lua .de2 { user-select: text; padding: 0px 8px; vertical-align: top; color: rgb(0, 0, 0); border-left: 1px solid rgb(221, 221, 221); margin: 0px 0px 0px -7px; position: relative; background: rgb(255, 255, 255); }

.lua { color: rgb(172, 172, 172); }

.lua .imp { font-weight: bold; color: red; }

.lua li, .lua .li1 { user-select: none; }

.lua .ln { width: 1px; text-align: right; margin: 0px; padding: 0px 2px; vertical-align: top; }

.lua .kw1 { color: rgb(170, 153, 0); font-weight: bold; }

.lua .kw2 { color: rgb(170, 153, 0); font-weight: bold; }

.lua .kw3 { color: rgb(0, 0, 170); }

.lua .kw4 { color: rgb(170, 153, 0); }

.lua .kw5 { color: rgb(170, 153, 0); }

.lua .co1 { color: rgb(128, 128, 128); font-style: italic; }

.lua .coMULTI { color: rgb(128, 128, 128); font-style: italic; }

.lua .es0 { color: rgb(0, 0, 153); font-weight: bold; }

.lua .es1 { color: rgb(0, 0, 153); font-weight: bold; }

.lua .es2 { color: rgb(0, 0, 153); font-weight: bold; }

.lua .br0 { color: rgb(102, 204, 102); }

.lua .sy0 { color: rgb(102, 204, 102); }

.lua .st0 { color: rgb(255, 102, 102); }

.lua .nu0 { color: rgb(204, 102, 204); }

.lua .me0 { color: rgb(170, 153, 0); }

.lua .ln-xtra, .lua li.ln-xtra, .lua div.ln-xtra { background: rgb(255, 255, 136); }

.lua span.xtra { display: block; }
