.textarea { background-color: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset; box-sizing: border-box; display: block; font-family: Consolas, Menlo, Monaco, "Lucida Console", "Liberation Mono", "DejaVu Sans Mono", "Bitstream Vera Sans Mono", monospace, serif; font-size: 13px; min-height: 200px; line-height: 21px; width: 100%; margin: 0px; padding: 8px 12px; overflow-wrap: break-word; height: 300px; tab-size: 4; }

.textarea.-raw { height: 100px; min-height: 60px; resize: vertical; }

.textarea.-comment { height: unset; min-height: 60px; }

.ui-tooltip { background: rgba(0, 0, 0, 0.8); color: rgb(255, 255, 255); font-size: 12px; font-weight: 600; line-height: 14px; text-shadow: none; text-transform: none; white-space: pre; overflow-wrap: break-word; padding: 8px; position: absolute; z-index: 9999; opacity: 1; letter-spacing: normal; max-width: none; }

.btn, .ui-tooltip { font-family: "segoe ui", "trebuchet MS", "Lucida Sans Unicode", "Lucida Sans", sans-serif; text-align: center; text-decoration: none; border: 0px; border-radius: 3px; }

.btn { background-color: rgb(221, 221, 221); border-bottom: 2px solid rgb(204, 204, 204); color: rgb(0, 0, 0); cursor: pointer; display: inline-block; font-size: 13px; font-weight: 400; height: 29px; line-height: 26px; min-width: 73px; padding: 0px 10px; }

.btn:hover { color: rgb(0, 0, 0); opacity: 0.8; }

.btn.-big { font-weight: 600; height: 35px; line-height: 34px; padding: 0px 25px; }

.btn.-small { font-size: 12px; height: 20px; line-height: 19px; padding: 0px 6px; opacity: 0.75; margin: 0px; min-width: auto; }

.btn.-small:hover { color: rgb(153, 153, 153); opacity: 0.75; }

.btn.-medium { font-size: 1.1em; text-align: left; width: 170px; margin: 0px 0px 10px; line-height: 27px; }

.btn.-medium:hover { color: rgb(153, 153, 153); }

.btn.-medium.-active { font-weight: 600; }

.btn.-pro { background: rgb(97, 186, 101); color: rgb(255, 255, 255); border-bottom: 0px; min-width: 230px; min-height: 40px; font-size: 16px; font-weight: 400; line-height: 40px; display: block; }

.btn.-second { margin-left: 10px; }

.btn.-like { padding-left: 22px; background: url("/themes/pastebin/sprite/spritesheet.webp") -23px -1908.5px / 78px 3208px no-repeat rgb(221, 221, 221); }

.btn.-like.-active { background: url("/themes/pastebin/sprite/spritesheet.webp") -23px -2040.5px / 78px 3208px no-repeat rgb(139, 195, 74); border-bottom: 2px solid rgb(139, 195, 74); color: rgb(255, 255, 255); }

.btn.-dislike { padding-left: 22px; background: url("/themes/pastebin/sprite/spritesheet.webp") -23px -1082.5px / 78px 3208px no-repeat rgb(221, 221, 221); }

.btn.-dislike.-active { background: url("/themes/pastebin/sprite/spritesheet.webp") -23px -1214.5px / 78px 3208px no-repeat rgb(244, 67, 54); border-bottom: 2px solid rgb(244, 67, 54); color: rgb(255, 255, 255); }

.btn.-transparent { cursor: default; background-color: rgba(0, 0, 0, 0); border-bottom: none; }

.btn.-transparent:hover { color: rgb(0, 0, 0); opacity: 0.75; }

input[type="checkbox"] { display: none; }

input[type="checkbox"] + label { line-height: 34px !important; }

input[type="checkbox"] + label > span:first-of-type { background-color: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); border-radius: 3px; cursor: pointer; display: inline-block; height: 21px; vertical-align: middle; width: 21px; margin: -1px 4px 0px 7px; }

input[type="checkbox"]:checked + label > span:first-of-type { background: url("/themes/pastebin/img/check.png") 4px 4px / 12px 12px no-repeat; }

.select { background-color: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset; color: rgb(24, 24, 24); font-size: 1em; min-width: 200px; width: 390px; padding: 8px; }

select { background: rgba(0, 0, 0, 0); }

.select2 { font-size: 0.8em; line-height: 35px; }

.select2.select2-container--default .select2-selection--single { box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset; height: 35px; background-color: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); border-radius: 3px; }

.select2.select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 32px; }

.select2.select2-container--default .select2-selection--single .select2-selection__arrow { height: 32px; }

.select2.select2-container--default.select2-container--disabled .select2-selection--single { background-color: rgb(238, 238, 238); cursor: not-allowed; }

.select2-container--default .select2-search--dropdown .select2-search__field { border: 1px solid rgb(221, 221, 221); font-size: 11px; line-height: 13.5px; }

.select2-results { font-size: 13px; margin: 0px; padding: 0px; }

.select2-results__option { line-height: 24px; padding: 2px 4px !important; }

.select2-results__group { color: rgb(153, 153, 153); padding: 2px 6px !important; }

.select2-hidden-accessible { transition: none !important; clip: unset !important; clip-path: unset !important; }

.input { background-color: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset; color: rgb(24, 24, 24); font-size: 1em; min-width: 200px; width: 390px; padding: 8px; }

.error-summary { margin: 0px 0px 10px; background: url("/themes/pastebin/img/warning.png") 10px 10px / 20px 20px no-repeat rgb(255, 255, 255); border-width: 1px 1px 1px 8px; border-style: solid; border-color: rgb(244, 67, 54); border-image: initial; border-radius: 3px; padding: 11px 10px 12px 38px; line-height: 18px; min-height: 20px; font-size: 0.8em; color: rgb(24, 24, 24); }

.error-summary p { display: none; }

.error-summary.-message { margin: 10px 0px 0px; font-size: 100%; }

.error { margin: 6px 0px; background: url("/themes/pastebin/img/warning.png") 10px 10px / 20px 20px no-repeat rgb(255, 255, 255); line-height: 20px; padding: 10px 10px 10px 38px; border-width: 1px 1px 1px 8px; border-style: solid; border-color: rgb(244, 67, 54); border-image: initial; border-radius: 3px; }

.error.-no-margin { margin: 0px; }

.page-api .developers-list { margin: 8px 0px 0px 30px; }

.page-api span.red { color: red; }

.page-tools .tools-list { margin: 8px 0px 0px 30px; }

.page-tools .chrome-box { border: 5px solid rgb(139, 195, 74); padding: 10px; }

.page-tools .chrome-recommended { color: rgb(139, 195, 74); }

.page-tools .iphone-recommended { color: red; }

.post-view { padding-top: 1px; padding-right: 2px; }

.post-view .details { height: 50px; margin: 0px 0px 7px; position: relative; display: flex; -webkit-box-pack: start; justify-content: flex-start; -webkit-box-align: center; align-items: center; padding-right: 60px; }

.post-view .user-icon { height: 46px; width: 46px; border: 1px solid rgb(221, 221, 221); border-radius: 3px; margin: -2px 10px 0px 0px; padding: 2px; }

.post-view .user-icon img { height: 40px; width: 40px; }

.post-view .info-bar { color: rgb(102, 102, 102); font-size: 0.8em; }

.post-view .info-top { line-height: 19px; height: 20px; overflow: hidden; }

.post-view .info-top h1 { color: rgb(51, 51, 51); display: inline; font-size: 1.25em; font-weight: 600; height: 20px; line-height: 19px; margin: 0px; padding: 0px; }

.post-view .info-top .unlisted { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -2629.25px / 78px 3208px no-repeat; }

.post-view .info-top .private, .post-view .info-top .unlisted { display: inline-block; width: 16px; height: 16px; vertical-align: top; margin: 3px 2px 0px 0px; }

.post-view .info-top .private { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -2242.25px / 78px 3208px no-repeat; }

.post-view .info-bottom { margin: 5px 0px 0px; height: 23px; line-height: 23px; overflow: hidden; font-size: 0.85em; text-transform: uppercase; display: flex; -webkit-box-pack: start; justify-content: flex-start; }

.post-view .info-bottom .username { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -2691.25px / 78px 3208px no-repeat; padding-left: 21px; }

.post-view .info-bottom .pro { background: url("/themes/pastebin/sprite/spritesheet.webp") -33.33px -3077.66px / 104px 4277.33px no-repeat; height: 14px; vertical-align: top; width: 28px; margin: 5px 0px 0px 4px; }

.post-view .info-bottom .pro:hover { background: url("/themes/pastebin/sprite/spritesheet.webp") -33.33px -3158.33px / 104px 4277.33px no-repeat; }

.post-view .info-bottom .message { display: block; background: url("/themes/pastebin/sprite/spritesheet.webp") -33.33px -4136.33px / 104px 4277.33px no-repeat; height: 14px; opacity: 1; width: 20px; margin: 5px 7px 0px 5px; }

.post-view .info-bottom .date { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -288.25px / 78px 3208px no-repeat; padding-left: 21px; margin-left: 8px; }

.post-view .info-bottom .visits { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -2757.25px / 78px 3208px no-repeat; padding-left: 22px; margin-left: 12px; }

.post-view .info-bottom .rating { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -2489.25px / 78px 3208px no-repeat; padding-left: 22px; margin-left: 12px; }

.post-view .info-bottom .expire { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -1278.5px / 78px 3208px no-repeat; padding-left: 21px; margin-left: 12px; }

.post-view .info-bottom .comments-info { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -156.5px / 78px 3208px no-repeat; padding-left: 21px; margin-left: 12px; }

.page-pro .pro_frame_big { width: 461px; float: left; padding-right: 10px; border-right: 1px solid rgb(242, 242, 242); }

.page-pro .main-heading { color: rgb(102, 102, 102); font-size: 1.5em; font-weight: 300; line-height: 1.5em; margin-bottom: 10px; text-align: center; }

.page-pro .features_frame { width: 450px; }

.page-pro .feature { width: 450px; clear: both; line-height: 40px; height: 41px; font-size: 0.85em; border-bottom: 1px solid rgb(242, 242, 242); }

.page-pro .feature_1 { float: left; width: 300px; }

.page-pro .feature_1.-top { border: 0px; }

.page-pro .feature_2 { float: left; text-align: center; width: 75px; color: rgb(204, 204, 204); font-weight: 400; border-left: 1px solid rgb(242, 242, 242); border-right: 1px solid rgb(242, 242, 242); height: 40px; }

.page-pro .feature_2.-top { background: rgb(221, 221, 221); color: rgb(255, 255, 255); font-weight: 700; border-radius: 5px 0px 0px; }

.page-pro .feature_3 { float: right; text-align: center; color: rgb(139, 195, 74); font-weight: 500; width: 75px; height: 40px; }

.page-pro .feature_3.-top { background: rgb(49, 187, 238); color: rgb(255, 255, 255); font-weight: 700; border-radius: 0px 5px 0px 0px; }

.page-pro .new_feature { background: url("/themes/pastebin/img/new_corner.png") 100% 0px / 30px no-repeat; }

.page-pro .icon { display: inline-block; vertical-align: top; border: 0px; }

.page-pro .icon.-info { background: url("/themes/pastebin/img/info.png") 0px 0px / 12px no-repeat; margin: 15px 5px 0px; height: 12px; width: 12px; }

.page-pro .icon.-delete { background: url("/themes/pastebin/img/delete_2.png") 0px 0px / 16px 16px no-repeat; margin: 13px 0px 0px; width: 16px; height: 16px; }

.page-pro .icon.-check { background: url("/themes/pastebin/img/check.png") 0px 0px / 16px 16px no-repeat; margin: 13px 0px 0px; width: 16px; height: 16px; }

.page-pro .icon.-night { width: 18px; height: 16.8px; margin: 12px 0px 0px; background: url("/themes/pastebin/img/night_icon.png") 0px 0px / 16px 16px no-repeat; }

.page-pro .icon.-pro { width: 28px; height: 14px; margin: 14px 0px 0px; background: url("/themes/pastebin/img/pro_btn_hover.png") 0px 0px / 28px 14px no-repeat; }

.page-pro .content_sub_title { border-bottom: 1px solid rgb(242, 242, 242); padding: 50px 0px 5px; font-size: 0.9em; font-weight: 600; margin: -50px 0px 0px; }

.page-pro .content_text { padding: 5px 0px 10px; font-size: 0.8em; line-height: 22px; }

.page-pro .content_text.-no-padding { padding: 0px; }

.page-pro .summary { float: left; font-size: 0.8em; max-height: 1000px; width: 290px; margin: 0px; padding: 10px 0px 0px 10px; }

.page-pro .summary_title { color: rgb(102, 102, 102); font-size: 1.5em; font-weight: 300; text-align: center; margin: 0px 0px 6px; }

.page-pro .pro_frame_life_top { color: rgb(255, 255, 255); background-color: rgb(49, 187, 238); border: 1px solid rgb(49, 187, 238); text-align: center; font-weight: 600; margin: 0px 0px -1px; border-radius: 3px 3px 0px 0px; padding: 5px; }

.page-pro .pro_frame { border-style: solid; border-color: rgb(49, 187, 238); border-image: initial; border-width: 1px 1px 2px; line-height: 2em; margin-bottom: 10px; padding: 10px; }

.page-pro .pro_frame.-lace { border-radius: 0px 0px 3px 3px; background: url("/themes/pastebin/img/lace_pro.png") right 10px top / 30px 30px no-repeat; }

.page-pro .pro_frame .buy_button { border-top: 1px dotted rgb(221, 221, 221); margin: 0px 0px 10px; padding: 10px 8px 0px 0px; text-align: center; }

.page-pro .pro_frame_gray { background: rgb(250, 250, 254); border-style: solid; border-color: rgb(221, 221, 221); border-image: initial; border-width: 1px 1px 2px; border-radius: 3px; line-height: 2em; margin-bottom: 10px; padding: 10px; }

.page-pro .blockquote { border-left: 4px solid rgb(204, 204, 204); padding: 10px; margin: 20px; }

.page-pro .buy_button { border-top: 1px dotted rgb(221, 221, 221); margin: 5px 0px 0px; padding: 10px 0px 0px; }

.page-pro .textarea { height: 100px; min-height: 100px; font-size: 13px; line-height: 21px; font-family: "segoe ui", "trebuchet MS", "Lucida Sans Unicode", "Lucida Sans", sans-serif; }

.page-news .content__title { position: relative; color: rgb(102, 102, 102); font-size: 24px; font-weight: 300; padding: 0px 0px 5px; border-bottom: none; margin-bottom: 20px; }

.page-news .content__sub_title { padding-right: 100px; border-bottom: none; font-size: 16px; }

.page-news .content__sub_title a { color: rgb(51, 51, 51); }

.page-news .content__sub_title a:hover { color: rgb(153, 153, 153); }

.page-news .details { color: rgb(153, 153, 153); font-weight: 400; font-size: 12px; padding-bottom: 10px; }

.page-news .content__text { padding-top: 0px; width: 100%; }

.page-news .content__text.-view { border-bottom: none; }

.page-news figure, .page-news p { margin-bottom: 10px; }

.page-news figure figcaption, .page-news p figcaption { font-size: 12px; color: rgb(153, 153, 153); }

.page-news figure > iframe { margin-left: calc(50% - 250px); }

.page-news .news__content { width: 100%; }

.page-news .news__item { display: flex; border-bottom: 1px solid rgb(242, 242, 242); }

.page-news .preview { padding: 15px 20px 15px 0px; }

.page-news .preview img { max-height: 190px; max-width: 250px; }

.user-view { padding-top: 1px; padding-right: 2px; }

.user-view .details { height: 50px; margin: 0px 0px 7px; position: relative; display: flex; -webkit-box-pack: start; justify-content: flex-start; -webkit-box-align: center; align-items: center; }

.user-view .user-icon { height: 46px; width: 46px; border: 1px solid rgb(221, 221, 221); border-radius: 3px; margin: -2px 10px 0px 0px; padding: 2px; }

.user-view .user-icon img { height: 40px; width: 40px; }

.user-view .info-bar { color: rgb(102, 102, 102); font-size: 0.8em; }

.user-view .info-top { line-height: 19px; height: 20px; overflow: hidden; }

.user-view .info-top h1 { color: rgb(51, 51, 51); display: inline; font-size: 1.25em; font-weight: 600; height: 20px; line-height: 19px; margin: 0px; padding: 0px; }

.user-view .info-top .pro { display: inline-block; background: url("/themes/pastebin/img/pro_btn.png") 0% 0% / 28px 14px no-repeat; height: 14px; width: 28px; vertical-align: middle; margin: 0px; }

.user-view .info-top .pro:hover { background: url("/themes/pastebin/img/pro_btn_hover.png") 0% 0% / 28px 14px no-repeat; }

.user-view .info-top .message { display: inline-block; background: url("/themes/pastebin/img/message.png") 0px 0px / 20px 14px no-repeat; height: 14px; width: 20px; vertical-align: middle; margin: 0px 0px 0px 2px; }

.user-view .info-bottom { margin: 5px 0px 0px; height: 23px; line-height: 23px; overflow: hidden; font-size: 0.85em; text-transform: uppercase; display: flex; -webkit-box-pack: start; justify-content: flex-start; }

.user-view .info-bottom .folder { background: url("/themes/pastebin/img/folder1.png") 0px 0px / 14px no-repeat; height: 14px; width: 14px; margin: 4px 6px 0px 0px; }

.user-view .info-bottom .web { background: url("/themes/pastebin/img/website.png") 0px 0px / 16px no-repeat; height: 16px; width: 16px; margin: 4px 8px 0px 0px; }

.user-view .info-bottom .twitter { background: url("/themes/pastebin/img/twitter_u.png") 0px 0px / 16px no-repeat; height: 16px; width: 16px; margin: 4px 8px 0px 0px; }

.user-view .info-bottom .facebook { background: url("/themes/pastebin/img/facebook_u.png") 0px 0px / 16px no-repeat; height: 16px; width: 16px; margin: 4px 8px 0px 0px; }

.user-view .info-bottom .location { padding-left: 24px; background: url("/themes/pastebin/img/location.png") 0px 4px / 16px no-repeat; }

.user-view .info-bottom .views { padding-left: 24px; background: url("/themes/pastebin/img/views.png") 4px 4px / 16px no-repeat; }

.user-view .info-bottom .views.-all { margin-left: 9px; padding-left: 25px; }

.user-view .info-bottom .date { margin-left: 12px; padding-left: 22px; background: url("/themes/pastebin/img/date.png") 0px 4px / 16px no-repeat; }

.user-view .info-bottom .date-text { cursor: help; border-bottom: 1px dotted; }

.user-view .info-bottom .rating { background: url("/themes/pastebin/img/rating.png") 0px 4px / 16px 16px no-repeat; padding-left: 22px; margin-left: 12px; }

.user-view .search-box { -webkit-box-flex: 1; flex-grow: 1; text-align: right; align-self: flex-start; padding-top: 1px; }

.user-view .search-box .search-input { border-radius: 3px; vertical-align: top; font-size: 14px; height: 30px; line-height: 30px; padding: 0px 7px 0px 34px; appearance: none; background: url("/themes/pastebin/img/search.png") 7px 7px / 16px no-repeat rgb(247, 247, 247); margin: 0px; color: rgb(0, 0, 0); border: 1px solid rgb(221, 221, 221); width: 200px; }

.user-view-jobs-create { font-size: 0.85em; text-align: right; align-self: flex-end; margin: 0px 0px 0px auto; }

.maintable { border-collapse: collapse; font-size: 0.8em; width: 100%; text-align: left; }

.maintable td { border-bottom: 1px solid rgb(242, 242, 242); vertical-align: top; padding: 0px 6px; line-height: 35px; }

.maintable tr:hover { background-color: rgb(250, 250, 250); }

.maintable th { border-bottom: 2px solid rgb(221, 221, 221); font-weight: 600; text-transform: uppercase; padding: 4px 6px; }

.maintable td a { color: rgb(0, 68, 170); text-decoration: none; }

.maintable td a:hover { color: rgb(201, 35, 28); text-decoration: none; }

.maintable img { vertical-align: top; }

.maintable .folder { background: url("/themes/pastebin/img/folder1.png") 0px 0px / 14px no-repeat; height: 14px; width: 14px; }

.maintable .folder, .maintable .status { display: inline-block; vertical-align: top; margin: 10px 7px 0px -5px; }

.maintable .status { height: 16px; width: 16px; }

.maintable .status.-public { background: url("/themes/pastebin/img/public.png") 0px 0px / 16px no-repeat; }

.maintable .status.-unlisted { background: url("/themes/pastebin/img/unlisted.png") 0px 0px / 16px no-repeat; }

.maintable .status.-private { background: url("/themes/pastebin/img/private.png") 0px 0px / 16px no-repeat; }

.maintable .message { display: inline-block; vertical-align: top; background: url("/themes/pastebin/img/message.png") 0px 0px / 20px 14px no-repeat; height: 14px; opacity: 0.5; width: 20px; margin: 10px 6px 0px -5px; }

.maintable .sort-down { background: url("/themes/pastebin/img/arrow_down.png") 0px 4px / 10px no-repeat; padding: 0px 0px 0px 15px; }

.maintable .sort-up { background: url("/themes/pastebin/img/arrow_up.png") 0px 4px / 10px no-repeat; padding: 0px 0px 0px 15px; }

.maintable .delete { display: inline-block; background: url("/themes/pastebin/img/delete.png") 0px 0px / 14px no-repeat; height: 14px; opacity: 0.5; width: 14px; margin: 11px -5px 0px 0px; vertical-align: top; }

.maintable .delete:hover { opacity: 1; }

.maintable .edit { display: inline-block; background: url("/themes/pastebin/img/edit.png") 0px 0px / 14px no-repeat; height: 14px; opacity: 0.5; width: 14px; margin: 11px 5px 0px 0px; vertical-align: top; }

.maintable .edit:hover { opacity: 1; }

.maintable .pro { display: inline-block; background: url("/themes/pastebin/img/pro_btn.png") 0% 0% / 28px 14px no-repeat; height: 14px; width: 28px; vertical-align: middle; margin: -2px 0px 0px; }

.maintable .pro:hover { background: url("/themes/pastebin/img/pro_btn_hover.png") 0% 0% / 28px 14px no-repeat; }

.maintable .pro.-message { margin-left: 6px; }

.td_smaller { color: rgb(102, 102, 102); font-size: 0.9em; }

td.verygood { color: rgb(139, 195, 74); background: url("/themes/pastebin/img/check.png") 0px 10px / 16px no-repeat; padding-left: 21px; font-weight: 600; }

.td_left { color: rgb(0, 0, 0); width: 150px; }

.td_right { text-align: right; }

.td_left { text-align: left; }

.pagination { font-size: 0.9em; margin: 10px 0px 3px; }

.pagination a { background: rgb(247, 247, 247); border-style: solid; border-color: rgb(221, 221, 221); border-image: initial; border-width: 1px 1px 2px; border-radius: 3px; color: rgb(51, 51, 51); margin: 0px 4px 0px 0px; padding: 5px 8px; line-height: 40px; }

.pagination a:hover { color: rgb(204, 0, 51); border-style: solid; border-color: rgb(204, 0, 51); border-image: initial; border-width: 1px 1px 2px; }

.pagination .active { color: rgb(153, 153, 153); border-style: solid; border-color: rgb(153, 153, 153); border-image: initial; border-width: 1px 1px 2px; }

.popup-container { bottom: 21px; right: 20px; position: fixed; z-index: 9999; }

.popup-container .popup-box { width: 350px; height: 90px; background: rgb(255, 255, 255); padding: 10px; margin-top: 10px; border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.17) 3px 3px 3px 0px; position: relative; }

.popup-container .popup-box.-cookies { font-size: 0.75em; height: 95px; }

.popup-container .popup-box.-night, .popup-container .popup-box.-pro { height: 70px; }

.popup-container .close { width: 14px; height: 14px; background: url("/themes/pastebin/img/close_promo.png") 0% 0% / contain; top: 5px; right: 5px; cursor: pointer; position: absolute; opacity: 1; }

.popup-container .close:hover { opacity: 0.8; }

.popup-container .cookie-button { border-radius: 4px; padding: 3px 5px; background-color: rgb(221, 221, 221); border-width: 1px 1px 2px; border-style: solid; border-color: rgb(221, 221, 221) rgb(221, 221, 221) rgb(204, 204, 204); border-image: initial; font-weight: 500; cursor: pointer; }

.popup-container .cookie-button:hover { opacity: 0.8; }

.popup-container .pro-promo-img { background: rgb(255, 255, 255); width: 60px; height: 50px; float: left; }

.popup-container .pro-promo-img img { width: 48px; height: 48px; }

.popup-container .pro-promo-text { color: rgb(51, 51, 51); float: right; display: block; font-size: 14px; font-weight: 400; width: 270px; }

.popup-container .pro-promo-text a { text-decoration: underline dotted; }

.diff__container { color: rgb(0, 0, 0); border: 1px solid rgb(221, 221, 221); background-color: rgb(255, 255, 255); font-size: 12px; overflow: auto; padding: 0px; }

.diff__container table { margin: 10px; }

.diff__action { cursor: pointer; color: rgb(204, 0, 51); background: rgb(255, 255, 255); padding: 2px 4px; margin: 0px; }

.diff__action:hover { color: rgb(153, 153, 153); }

