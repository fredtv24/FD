.message__reply_area { padding: 10px 0px; }

.message__invalid { text-align: left; font-size: 0.8em; line-height: 22px; padding: 10px 0px; }

.share { position: absolute; top: 1px; right: 0px; }

.share-btn { border-radius: 3px; color: rgb(255, 255, 255); cursor: pointer; font-weight: 600; height: 20px; line-height: 20px; width: 57px; margin: 0px 0px 6px; padding: 0px 0px 0px 15px; opacity: 1; }

.share-btn:hover { opacity: 0.8; }

.share-btn span { font-size: 0.65em; display: block; text-align: center; }

.share .facebook { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -1347.5px / 78px 3208px no-repeat rgb(59, 89, 152); }

.share .twitter { background: url("/themes/pastebin/sprite/spritesheet.webp") -25px -2558.25px / 78px 3208px no-repeat rgb(85, 172, 238); margin: 0px; }

.toggle { display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: justify; justify-content: space-between; width: 100%; }

.toggle.is-on .toggle__text { color: inherit; }

.toggle__text { padding-right: 5px; }

.toggle__control { position: relative; display: flex; -webkit-box-align: center; align-items: center; width: 100%; -webkit-box-flex: 0; flex: 0 1 0%; min-width: 30px; --toggleAreaColorChecked: #fff; --toggleBorderColorChecked: #dedede; --successColor: #56b65b; }

body.night .toggle__control { --toggleAreaColorChecked: #2c4e3c; --toggleBorderColorChecked: #2c4e3c; --successColor: #56b65b; }

.toggle__control input { position: absolute; visibility: hidden; z-index: -9999; }

.toggle__control input:checked + label { background: var(--toggleAreaColorChecked); border-color: var(--toggleBorderColorChecked); }

.toggle__control input:checked + label::after { left: 50%; background: var(--successColor); }

.toggle__control label { --toggleAreaColor: #fff; --toggleAreaBorderColor: #dedede; --toggleCircleColor: #dedede; outline: 0px; display: inline-block; width: 28px; height: 10px; position: relative; cursor: pointer; user-select: none; background: var(--toggleAreaColor); border: 1px solid var(--toggleAreaBorderColor); border-radius: 30px; transition: 0.3s; box-sizing: border-box; }

body.night .toggle__control label { --toggleAreaColor: #61676e; --toggleAreaBorderColor: #61676e; --toggleCircleColor: #b5b3b3; }

.toggle__control label::after { position: absolute; top: 50%; left: -2px; transform: translateY(-50%); display: block; content: ""; width: 16px; height: 16px; border-radius: 50%; background: var(--toggleCircleColor); transition: 0.3s; }

.CodeMirror { height: inherit; background-color: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset; box-sizing: border-box; font-family: Consolas, Menlo, Monaco, "Lucida Console", "Liberation Mono", "DejaVu Sans Mono", "Bitstream Vera Sans Mono", monospace, serif; font-size: 13px; min-height: 200px; line-height: 21px; width: 100%; margin: 0px; padding: 4px 8px; overflow-wrap: break-word; }

.CodeMirror-cursor { border-left-color: rgb(24, 24, 24); }

[data-language="diff"].field-postform-text span.cm-meta { color: rgb(170, 0, 187) !important; }

[data-language="diff"].field-postform-text span.cm-error { background-color: rgb(0, 0, 0); opacity: 0.4; }

[data-language="diff"].field-postform-text span.cm-error.cm-string { background-color: red; }

[data-language="diff"].field-postform-text span.cm-error.cm-tag { background-color: rgb(34, 187, 34); }

[data-language="text/x-rsrc"].field-postform-text .cm-s-default span.cm-semi { color: rgb(0, 0, 255); font-weight: 700; }

[data-language="text/x-rsrc"].field-postform-text .cm-s-default span.cm-dollar { color: orange; font-weight: 700; }

[data-language="text/x-rsrc"].field-postform-text .cm-s-default span.cm-arg-is, [data-language="text/x-rsrc"].field-postform-text .cm-s-default span.cm-arrow { color: brown; }

.comments { margin-top: 20px; }

.comments ul { border-left: 1px solid rgb(221, 221, 221); }

