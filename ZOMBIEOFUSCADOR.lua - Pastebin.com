.form-horizontal .form-group.has-error .checkbox, .form-horizontal .form-group.has-error .checkbox-inline, .form-horizontal .form-group.has-error.checkbox-inline label, .form-horizontal .form-group.has-error .checkbox label, .form-horizontal .form-group.has-error .control-label, .form-horizontal .form-group.has-error .help-block, .form-horizontal .form-group.has-error .radio, .form-horizontal .form-group.has-error .radio-inline, .form-horizontal .form-group.has-error.radio-inline label, .form-horizontal .form-group.has-error .radio label { color: rgb(24, 24, 24); }

