.ms { position: relative; cursor: pointer; box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset; height: 35px; background-color: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); border-radius: 3px; font-size: 0.8em; }

.ms_cur { padding-left: 8px; padding-right: 20px; line-height: 35px; }

.ms_cur::after { position: absolute; top: 50%; right: 8px; transform: translateY(-50%); display: block; content: ""; border-color: rgb(136, 136, 136) rgba(0, 0, 0, 0) rgba(0, 0, 0, 0); border-style: solid; border-width: 5px 4px 0px; }

.ms_results { display: none; position: fixed; z-index: 100; }

.ms_filter { margin: 0px -1px; padding: 4px; background: rgb(255, 255, 255); width: 100%; border-left: 1px solid rgb(170, 170, 170); border-right: 1px solid rgb(170, 170, 170); }

.ms_filter input { border: 1px solid rgb(221, 221, 221); font-size: 11px; line-height: 13.5px; padding: 4px; width: 100%; }

.ms_list { width: 100%; line-height: 1; background: rgb(255, 255, 255); border-right: 1px solid rgb(170, 170, 170); border-bottom: 1px solid rgb(170, 170, 170); border-left: 1px solid rgb(170, 170, 170); border-image: initial; border-top: none; margin: 0px -1px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; max-height: 200px; overflow-y: auto; }

.ms_opt { width: 100%; line-height: 1.5; display: none; padding: 4px 15px; text-align: left; cursor: pointer; }

.ms_opt.is-active { background-color: rgb(221, 221, 221); }

.ms_opt[data-sel="true"] { background-color: rgb(88, 151, 251); color: rgb(255, 255, 255); }

.ms_opt[data-title="true"] { font-weight: 700; padding: 2px 6px !important; }

.ms_opt[data-dis="true"], .ms_opt[data-title="true"] { cursor: default; background-color: rgb(255, 255, 255); color: rgb(153, 153, 153); pointer-events: none; }

.ms_opt[data-vis="true"] { display: list-item; }

.ms_opt.-no { cursor: default; display: none; }

.ms.is-open { border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; }

.ms.is-open .ms_results { display: block; }

.ms.is-open .ms_cur::after { border-color: rgba(0, 0, 0, 0) rgba(0, 0, 0, 0) rgb(136, 136, 136); border-width: 0px 4px 5px; }

