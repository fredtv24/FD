.highlighted-code { border: 1px solid rgb(221, 221, 221); border-radius: 3px; margin: 0px 0px 20px; color: rgb(51, 51, 51); font-family: Consolas, Menlo, Monaco, "Lucida Console", "Liberation Mono", "DejaVu Sans Mono", "Bitstream Vera Sans Mono", monospace, serif; }

.highlighted-code .top-buttons { border-bottom: 1px solid rgb(221, 221, 221); font-size: 0.65em; background: rgb(247, 247, 247); text-align: left; padding: 5px 8px; display: flex; -webkit-box-pack: justify; justify-content: space-between; }

.highlighted-code .top-buttons .right .btn { margin-left: 1.8px; }

.highlighted-code .source { font-size: 12px; overflow-x: auto; }

.highlighted-code .source > ol { background: rgb(247, 247, 247) !important; margin: 0px !important; padding: 0px 0px 0px 55px !important; }

.highlighted-code .source > ol li { display: list-item; list-style-type: decimal; }

.highlighted-code .source li.li1, .highlighted-code .source li.li2 { list-style-type: decimal; background: rgb(255, 255, 255); margin: 0px 0px 0px -6px; color: rgb(172, 172, 172); font-family: Consolas, Menlo, Monaco, "Lucida Console", "Liberation Mono", "DejaVu Sans Mono", "Bitstream Vera Sans Mono", monospace, serif; }

.highlighted-code .source li.li1 .de1, .highlighted-code .source li.li1 .de2, .highlighted-code .source li.li2 .de1, .highlighted-code .source li.li2 .de2 { white-space: pre-wrap; }

.highlighted-code .source ul { margin-block: 1em; padding-inline-start: 40px; }

.highlighted-code .source ul li { display: list-item; list-style-type: disc; }

.highlighted-code .source code { padding: 3px; margin: 0px; background-color: rgba(27, 31, 35, 0.05); border-radius: 3px; color: rgb(51, 51, 51); }

.highlighted-code .source blockquote { margin: 0px; padding: 0px 5px; color: rgb(106, 115, 125); border-left: 2px solid rgb(223, 226, 229); }

.highlighted-code .source table { margin: 8px 0px 8px 10px; overflow: auto; border-spacing: 0px; border-collapse: collapse; display: table; }

.highlighted-code .source table td, .highlighted-code .source table th { padding: 4px 8px; border: 1px solid rgb(223, 226, 229); }

.highlighted-code .source hr { height: 3px; padding: 0px; margin: 12px 0px; background-color: rgb(225, 228, 232); border: 0px; }

.highlighted-code .source ol { background: rgb(255, 255, 255); color: rgb(51, 51, 51); padding: 0px 10px; }

.highlighted-code .source p { display: block; margin-block: 1em; margin-inline: 0px; }

.highlighted-code .source h1 { font-size: 2em; margin-block: 0.67em; font-weight: 700; }

.highlighted-code .source h2 { font-size: 1.5em; margin-block: 0.83em; font-weight: 700; }

.highlighted-code .source h3 { font-size: 1.17em; margin-block: 1em; font-weight: 700; }

.highlighted-code .source h4 { margin-block: 1.33em; font-weight: 700; }

.highlighted-code .source h5 { font-size: 0.83em; margin-block: 1.67em; font-weight: 700; }

.highlighted-code .source h6 { font-size: 0.67em; margin-block: 2.33em; font-weight: 700; }

.highlighted-code .source.-delete { padding: 0px 8px; color: grey; }

.highlighted-code .source pre { overflow: unset; }

.highlighted-code .source.markdown { padding: 0px 8px; }

.highlighted-code .source .snippet { white-space: pre; }

