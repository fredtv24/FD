.night .post-search-title a:hover { color: rgb(204, 204, 204); }

@media screen and (max-width: 1340px) {
  html { font-size: 16px; }
}

@media screen and (max-width: 768px) {
  html { font-size: 15px; }
  .container { max-width: 510px; }
}

@media screen and (max-width: 510px) {
  html { font-size: 14px; }
  .container { max-width: 320px; }
}

@media screen and (max-width: 980px) {
  .container { max-width: 768px; }
}

@media (prefers-color-scheme: dark) {
  .night-auto { color: rgb(221, 221, 221); background-color: rgb(37, 37, 37); }
  .night-auto a { color: rgb(129, 182, 222); }
  .night-auto a:hover { color: rgb(153, 153, 153); text-decoration: none; }
  .night-auto .wrap { background-color: rgb(43, 43, 43); }
  .night-auto .header { background-color: rgb(37, 37, 37); background-image: linear-gradient(rgb(37, 37, 37), rgb(43, 43, 43)); box-shadow: rgb(51, 51, 51) 0px 1px 1px 0px; }
  .night-auto .header__logo { color: rgb(255, 255, 255); }
  .night-auto .header__logo:hover { color: rgb(255, 255, 255); text-decoration: none; }
