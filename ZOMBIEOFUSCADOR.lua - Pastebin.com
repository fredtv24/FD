.diff__table { margin: 10px; }

.diff__table td { padding-left: 3px; padding-right: 3px; text-align: right; }

.diff__table td.code { text-align: left; }

.diff__table td.code pre { font-family: Consolas, Menlo, Monaco, "Lucida Console", "Liberation Mono", "DejaVu Sans Mono", "Bitstream Vera Sans Mono", monospace, serif; font-size: 12px; margin: 0px; padding: 0px; background: rgba(0, 0, 0, 0); border: none; }

.diff__table tr.new { background: rgb(221, 221, 255); }

.diff__table tr.old { background: rgb(255, 221, 221); }

.user-page { padding-top: 2px; padding-right: 2px; }

