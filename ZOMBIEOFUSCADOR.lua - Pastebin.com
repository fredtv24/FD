.login-page .login-social.-facebook { background: url("/themes/pastebin/img/facebook_svg.png") 3px 5px / 20px 20px no-repeat rgb(59, 89, 152); }

.login-page .login-social.-twitter { background: url("/themes/pastebin/img/twitter_svg.png") 5px 7px / 20px 20px no-repeat rgb(85, 172, 238); }

.login-page .login-social.-google { background: url("/themes/pastebin/img/google_svg.png") 5px 7px / 20px 20px no-repeat rgb(224, 47, 47); }

.login-page .tagline { border-bottom: 1px solid rgb(221, 221, 221); height: 16px; text-align: center; margin: 0px 0px 6px; max-width: 568px; clear: left; }

.login-page .tagline span { background: rgb(255, 255, 255); color: rgb(221, 221, 221); display: inline; font-size: 0.7em; font-weight: 400; position: relative; top: 1px; padding: 0px 6px; }

.login-page fieldset.login-field { border-radius: 3px; border-style: solid; border-color: rgb(221, 221, 221); border-image: initial; border-width: 1px 1px 2px; display: inline; font-size: 0.7em; margin-top: -2px; padding: 0px 10px; }

.login-page fieldset.login-field legend { color: rgb(221, 221, 221); margin: 0px; padding: 0px 8px; display: block; width: auto; border: 0px; }

.login-page fieldset { margin-inline: 2px; padding-block: 0.35em 0.625em; padding-inline: 0.75em; border: 2px groove threedlightshadow; min-inline-size: min-content; }

.login-page .main-heading { color: rgb(102, 102, 102); font-size: 1.5em; font-weight: 300; line-height: 1.5em; margin-bottom: 10px; text-align: left; }

.login-page .terms-check { font-size: 0.9em; margin-bottom: 20px; }

.login-page .terms-check input[type="checkbox"] + label > span:first-of-type { margin-left: 0px; }

