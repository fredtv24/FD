.login-page .terms-links { font-size: 0.72em; color: rgb(102, 102, 102); line-height: 19px; margin-top: 27px; margin-bottom: 53px; }

.search__container { text-align: right; float: right; }

.search__form { display: inline; margin: 0px; padding: 0px; }

.search__input-self { border-radius: 3px; font-family: "segoe ui", "trebuchet MS", "Lucida Sans Unicode", "Lucida Sans", sans-serif; vertical-align: top; font-size: 14px; height: 30px; line-height: 30px; padding: 0px 7px 0px 34px; appearance: none; width: 200px; background: url("/themes/pastebin/img/search.png") 7px 7px / 16px no-repeat rgb(247, 247, 247); margin: 0px; color: rgb(0, 0, 0); border: 1px solid rgb(221, 221, 221); font-weight: 400; }

.dmca-form .copyright-field { width: 600px; height: 231px; border-bottom: 1px dotted rgb(204, 204, 204); margin: 5px 0px; font-size: 0.8em; line-height: 22px; padding: 10px 0px; }

