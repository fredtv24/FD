  .night-auto .content__title { border-bottom: 2px solid rgb(51, 51, 51); color: rgb(221, 221, 221); }
  .night-auto .content__title.-no-border { border: none; }
  .night-auto .post-form .upload-frame { background-color: rgb(43, 43, 43); border: none; color: rgb(221, 221, 221); }
