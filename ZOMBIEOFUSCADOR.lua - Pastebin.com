  .night-auto .page table.maintable th { border-bottom: 2px solid rgb(51, 51, 51); }
  .night-auto .page table.maintable td { border-bottom: 1px solid rgb(51, 51, 51); }
  .night-auto .input, .night-auto .page img.night_mode { border: 1px solid rgb(51, 51, 51); }
  .night-auto .input { background-color: rgb(43, 43, 43); color: rgb(221, 221, 221); }
  .night-auto .form-horizontal .form-group input:disabled.form-control { background-color: rgb(37, 37, 37); }
  .night-auto .user-page .login_field { border-color: rgb(51, 51, 51); }
