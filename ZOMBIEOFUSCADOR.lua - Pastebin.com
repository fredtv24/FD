.form-horizontal .form-group .form-control { height: 33px; padding: 8px; font-size: 0.8em; font-weight: 400; border: 1px solid rgb(221, 221, 221); border-radius: 3px; }

.form-horizontal .form-group .form-control, .form-horizontal .form-group .form-control:focus { box-shadow: rgba(0, 0, 0, 0.075) 0px 1px 1px inset; background-color: rgb(255, 255, 255); }

.form-horizontal .form-group .form-control:focus { border: 1px solid rgb(221, 221, 221); }

