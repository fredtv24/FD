------MultipartBoundary--rkW4YMVhEKPrlzEYleyKRwwWdSrjR294lt7w33ax6B----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://pastebin.com/themes/pastebin/css/app.bundle.css?30d6ece6979ee0cf5531

@charset "utf-8";

a.lb-close { display: none !important; }

body.lb-disable-scrolling { overflow: hidden; }

.lightboxOverlay { position: absolute; top: 0px; left: 0px; z-index: 9999; background-color: rgb(0, 0, 0); opacity: 0.8; display: none; }

.lightbox { position: absolute; left: 0px; width: 100%; z-index: 10000; text-align: center; line-height: 0; font-weight: 400; outline: none; }

.lightbox .lb-image { display: block; height: auto; max-width: inherit; max-height: none; border-radius: 3px; border: 4px solid rgb(255, 255, 255); }

.lightbox a img { border: none; }

.lb-outerContainer { position: relative; width: 250px; height: 250px; margin: 0px auto; border-radius: 4px; background-color: rgb(255, 255, 255); }

.lb-outerContainer::after { content: ""; display: table; clear: both; }

a, abbr, acronym, address, applet, article, aside, audio, b, big, blockquote, body, canvas, caption, center, cite, code, dd, del, details, dfn, div, dl, dt, em, embed, fieldset, figcaption, figure, footer, form, h1, h2, h3, h4, h5, h6, header, hgroup, html, i, iframe, img, ins, kbd, label, legend, li, mark, menu, nav, object, ol, output, p, pre, q, ruby, s, samp, section, small, span, strike, strong, sub, summary, sup, table, tbody, td, tfoot, th, thead, time, tr, tt, u, ul, var, video { margin: 0px; padding: 0px; font-size: 100%; vertical-align: baseline; }

a, a:active, a:hover { text-decoration: none; }

a:active, a:hover { outline: 0px; }

h1, h2, h3, h4, h5, h6 { font-size: 100%; font-weight: 400; }

html { box-sizing: border-box; }

:focus { outline: 0px; }

audio, img, video { max-width: 100%; height: auto; }

audio, canvas, iframe, img, svg, video { vertical-align: middle; }

iframe { border: 0px; }

textarea { resize: none; overflow: auto; vertical-align: top; box-shadow: none; }

button, input, select, textarea { outline: none; border: none; font-size: 100%; margin: 0px; }

button, input { line-height: normal; }

table { border-collapse: collapse; border-spacing: 0px; }

td, th { padding: 0px; text-align: left; }

body, html { line-height: 24px; font-size: 16px; color: rgb(24, 24, 24); height: 100%; }

body { padding: 0px; font-family: "segoe ui", "trebuchet MS", "Lucida Sans Unicode", "Lucida Sans", sans-serif; font-weight: 400; text-size-adjust: none; background-color: rgb(255, 255, 255); }

body, h1, h2, h3, h4, h5, h6 { margin: 0px; }

.link, a { cursor: pointer; text-decoration: none; color: rgb(204, 0, 51); }

.link:hover, a:hover { color: rgb(153, 153, 153); text-decoration: none; }

.link:focus, a:focus { color: rgb(204, 0, 51); text-decoration: none; }

li, ul { margin: 0px; padding: 0px; list-style-type: none; }

.wrap { min-height: 100%; height: auto; margin: 0px auto -226px; padding: 0px 0px 226px; background: rgb(247, 247, 247); }

.wrap > .container { padding: 58px 0px 10px; background: rgb(255, 255, 255); min-height: calc(-226px + 100vh); border-bottom: 1px solid rgb(221, 221, 221); border-left: 1px solid rgb(221, 221, 221); border-radius: 0px 0px 3px 3px; border-right: 1px solid rgb(221, 221, 221); display: grid; grid-template-rows: 1fr; grid-template-columns: 1fr 320px; }

.wrap > .container::before { content: none; }

.container { width: 100%; -webkit-box-flex: 0; flex: 0 0 auto; position: relative; margin: 0px auto; max-width: 1340px; }

.hide { display: none; }

.hide-important { display: none !important; }

span.red { color: red; }

span.green { color: green; }

.help-block { margin: 0px; }

span.required { color: red; font-weight: 700; }

.text-small { font-size: 12px; }

.badge-new { display: inline-block; height: 14px; background: rgb(244, 67, 54); color: rgb(255, 255, 255); margin-left: 5px; font-size: 10px; padding: 1px 4px; border-radius: 2px; line-height: 13px; font-weight: 700; }

.gsc-results .gsc-cursor-box .gsc-cursor-page { background-color: rgb(247, 247, 247); color: rgb(102, 102, 102); padding: 6px 9px; border-radius: 3px; border-style: solid; border-color: rgb(221, 221, 221); border-image: initial; border-width: 1px 1px 3px; }

.gs-result .gs-title, .gs-result .gs-title * { text-decoration: none !important; }

.gs-result .gs-title, .gs-result .gs-title *, .gsc-control-cse, .gsc-control-cse .gsc-table-result { font-family: "segoe ui", "trebuchet MS", "Lucida Sans Unicode", "Lucida Sans", sans-serif; }

.cse .gsc-control-cse, .gsc-control-cse { padding: 0px !important; }

.gsc-selected-option-container { box-sizing: unset; }

.anchor { display: block; position: relative; top: -55px; visibility: hidden; }

.data__stats { display: flex; -webkit-box-pack: end; justify-content: flex-end; -webkit-box-align: center; align-items: center; font-size: 12px; height: 53px; }

.header { width: 100%; height: 50px; background: linear-gradient(rgb(2, 56, 89), rgb(2, 69, 108)) rgb(2, 56, 89); box-shadow: rgba(0, 0, 0, 0.52) 0px 1px 1px 0px; color: rgb(255, 255, 255); position: fixed; top: 0px; right: 0px; left: 0px; font-size: 0.8em; z-index: 1030; }

.header > .container { height: 100%; padding: 0px; }

.header__container { -webkit-box-pack: justify; justify-content: space-between; }

.header__container, .header__left { height: 100%; display: flex; -webkit-box-align: center; align-items: center; }

.header__left { -webkit-box-pack: start; justify-content: flex-start; }

.header__right { height: 100%; display: flex; -webkit-box-pack: end; justify-content: flex-end; -webkit-box-align: center; align-items: center; }

.header__logo { display: block; height: 100%; background: url("/themes/pastebin/img/pastebin_logo_side_outline_support_ukraine.webp") 5px 3px / 45px no-repeat; color: rgb(255, 255, 255); cursor: pointer; font-size: 1.75em; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; margin: 0px 25px 0px -5px; padding: 13px 0px 0px 48px; }

.header__logo:focus, .header__logo:hover { color: rgb(255, 255, 255); }

.header__btn { background-image: url("/themes/pastebin/sprite/spritesheet.webp"); background-position: -17px -16px; background-color: rgb(97, 186, 101); background-size: 78px 3208px; border-radius: 3px; color: rgb(255, 255, 255); cursor: pointer; font-size: 1em; font-weight: 400; height: 30px; line-height: 28px; text-transform: lowercase; margin: 2px 8px 0px 3px; padding: 0px 10px 0px 26px; }

.header__btn:hover { background-color: rgb(86, 182, 91); color: rgb(255, 255, 255); }

.header__links { height: 100%; display: flex; -webkit-box-pack: justify; justify-content: space-between; -webkit-box-align: center; align-items: center; }

.header__links a { margin: 0px 24px 0px 12px; color: rgb(255, 255, 255); text-transform: uppercase; }

.header__links a:hover { color: rgb(255, 255, 255); }

.header__links .pro { background: url("/themes/pastebin/img/pro_btn_big.png") 23px 5px / 36px 22px no-repeat; padding: 3px 42px 3px 0px; }

.header__search form { display: inline; height: 30px; margin: 0px; padding: 0px; position: relative; }

.header__search input.search_input { background: rgb(2, 80, 125); border: 0px; border-radius: 3px; color: rgb(255, 255, 255); vertical-align: top; font-size: 12px; width: 160px; height: 30px; line-height: 30px; margin: 2px 0px 0px 16px; padding: 0px 34px 0px 7px; appearance: none; }

.header__search .search_btn { width: 33px; height: 30px; background: rgba(0, 0, 0, 0); position: absolute; top: -2px; right: 0px; opacity: 0.8; padding-right: 7px; }

.header__search .search_btn, .header__search .search_btn:hover { transition: 0.3s; }

.header__search .search_btn:hover { opacity: 1; }

.header__search .search_btn .icon { vertical-align: top; }

.header__icon { cursor: pointer; height: 20px; width: 20px; margin: 2px 10px 0px; }

.header__icon.pastebin { background: url("/themes/pastebin/img/dd_pastebin.png") 0% 0% / 18px 20px no-repeat; margin-right: 13px; }

.header__icon.my-comments { background: url("/themes/pastebin/img/dd_comments.png") 0% 0% / 20px no-repeat; margin-right: 14px; }

.header__icon.my-jobs { background: url("/themes/pastebin/img/dd_jobs.png") 0% 0% / 20px no-repeat; margin-right: 14px; }

.header__icon.messages { background: url("/themes/pastebin/img/dd_messages.png") 0% 0% / 20px no-repeat; margin-right: 14px; }

.header__icon.alerts { background: url("/themes/pastebin/img/dd_alerts.png") 0% 0% / 20px no-repeat; margin-right: 14px; }

.header__icon.settings { background: url("/themes/pastebin/img/dd_settings.png") 0% 0% / 20px no-repeat; }

.header__dropdown-icon { background-image: url("/themes/pastebin/sprite/spritesheet.webp"); background-position: -16px -2095.5px; background-size: 78px 3208px; cursor: pointer; display: block; height: 30px; width: 25px; margin-top: 2px; margin-right: 5px; }

.header__user-frame { text-align: right; margin-left: 10px; height: 100%; padding-top: 11px; }

.header__user-name { line-height: 15px; max-width: 160px; overflow: hidden; }

.header__user-status { color: rgb(204, 204, 204); font-size: 10px; line-height: 16px; }

.header__user-icon img { border: 1px solid rgb(51, 102, 153); border-radius: 3px; height: 32px; width: 32px; margin: 4px 0px 0px 10px; }

.header .header_sign { height: 30px; line-height: 30px; text-align: right; margin: 2px 5px 0px 0px; padding-right: 15px; }

.header .header_sign a.btn-sign { display: inline-block; border: 1px solid rgb(255, 255, 255); border-radius: 3px; color: rgb(255, 255, 255); cursor: pointer; font-size: 1em; font-weight: 400; height: 30px; line-height: 23px; margin: 0px 0px 0px 5px; padding: 3px 0px; width: 71px; text-align: center; text-transform: uppercase; }

.header .header_sign a.btn-sign.sign-in { color: rgb(255, 255, 255); background: rgba(0, 0, 0, 0); }

.header .header_sign a.btn-sign.sign-in:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.2); }

.header .header_sign a.btn-sign.sign-up { color: rgb(2, 63, 99); background: rgb(255, 255, 255); }

.header .header_sign a.btn-sign.sign-up:hover { color: rgb(2, 63, 99); background: rgba(255, 255, 255, 0.8); }

.header .badge-pro { display: inline-block; width: 28px; height: 14px; margin-top: 2px; background-image: url("/themes/pastebin/sprite/spritesheet.webp"); background-position: -33.33px -3158.33px; background-size: 104px 4277.33px; }

.footer { height: 150px; border-top: 1px solid rgb(221, 221, 221); color: rgb(204, 204, 204); background: rgb(255, 255, 255); font-size: 0.8em; font-weight: 400; }

.footer > .container { height: 100%; padding: 0px; }

.footer__container { height: 100%; display: flex; -webkit-box-pack: justify; justify-content: space-between; -webkit-box-align: center; align-items: center; }

.footer__left { height: 100%; color: rgb(221, 221, 221); padding: 18px 10px 10px; line-height: 24px; }

.footer__left a { color: rgb(153, 153, 153); }

.footer__left a:hover { color: rgb(102, 102, 102); }

.footer__left sup { font-size: smaller; }

.footer__right { height: 100%; display: flex; -webkit-box-pack: justify; justify-content: space-between; -webkit-box-align: start; align-items: flex-start; padding-top: 15px; width: 104px; }

.footer__right .icon-link { margin: 0px 5px; opacity: 0.8; }

.footer__right .icon-link:hover { opacity: 1; }

.top-footer { width: 100%; padding: 26px 0px 25px; min-height: 75px; background: rgb(247, 247, 247); display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; }

.top-footer .icon-link { margin: 0px 12.5px; opacity: 0.3; }

.top-footer .icon-link:hover { opacity: 1; }

.special__header { text-align: center; }

.special__sidebar { padding: 0px; width: 160px; margin: 10px 0px; text-align: center; }

.special__footer { width: 100%; }

.special__category, .special__footer, .special__user { margin: 10px 0px 0px; text-align: center; }

.special__raw { width: 100%; margin: 10px 0px; text-align: center; }

.page.-top { padding-top: 2px; }

.page.-right { padding-right: 2px; }

.page span.mark { font-weight: 400; background: rgb(247, 247, 247); border: 1px solid rgb(221, 221, 221); border-radius: 3px; padding: 3px 5px; margin: 0px; line-height: 30px; }

.page .boostit { color: rgb(2, 80, 125) !important; }

.page .code_box { background-color: rgb(247, 247, 247); border: 1px solid rgb(221, 221, 221); border-radius: 3px; font-family: Consolas, Menlo, Monaco, "Lucida Console", "Liberation Mono", "DejaVu Sans Mono", "Bitstream Vera Sans Mono", monospace, serif; font-size: 12px; overflow: auto; white-space: pre; margin: 10px; padding: 7px 15px; width: 95%; }

.page .content__sub_title { border-bottom: 1px solid rgb(221, 221, 221); margin: 10px 0px 0px; font-size: 0.9em; font-weight: 600; line-height: 24px; position: relative; }

.page .tools_screenshots { padding-bottom: 10px; }

.page .tools_screenshots img { border: 1px solid rgb(204, 204, 204); margin: 0px 8px 0px 0px; padding: 2px; }

.page table.maintable { width: 100%; text-align: left; border-collapse: collapse; border-spacing: 0px; font-size: 0.8em; }

.page table.maintable th { border-bottom: 2px solid rgb(221, 221, 221); font-weight: 600; text-transform: uppercase; padding: 4px 6px; line-height: 24px; }

.page table.maintable td { border-bottom: 1px solid rgb(242, 242, 242); vertical-align: top; padding: 0px 6px; line-height: 35px; }

.page table.maintable td a { color: rgb(0, 68, 170); text-decoration: none; }

.page .tools_download { font-size: 0.9em; padding: 5px 0px 0px; }

.page .content__text { font-size: 0.8em; line-height: 22px; padding: 10px 0px; }

.page .content__text.-no-padding { padding: 0px; }

.page .content__text.-top { padding-top: 10px; }

.page .lang_div { float: left; padding: 5px 0px; width: 25%; border-bottom: 1px solid rgb(221, 221, 221); line-height: 24px; }

.page .lang_div a { color: rgb(0, 68, 170); text-decoration: none; }

.page .lang_div a:hover { color: rgb(201, 35, 28); }

.page .lang_div span.llb { float: right; color: rgb(204, 204, 204); font-size: 0.9em; padding: 0px 10px 0px 0px; }

.page.night_mode .notice { margin: 10px 0px 0px; }

.page .pro_btn_inv { background: url("/themes/pastebin/img/pro_btn_hover.png") 0% 0% / 28px 14px no-repeat; height: 14px; width: 28px; vertical-align: top; margin: 4px 0px 0px; }

.page img.night_mode { border: 1px solid rgb(204, 204, 204); border-radius: 3px; margin-right: 10px; padding: 3px; }

.page .archive-table { padding: 0px 0px 10px; margin-top: -10px; }

.page .faq-list { margin: 8px 0px 0px 30px; font-weight: 600; }

.page .captcha-wrapper input { display: inline; width: 118px; min-width: 118px; }

.page .captcha-wrapper .captcha-reload { vertical-align: top; margin: 8px 0px 0px 8px; cursor: pointer; width: 16px; height: 16px; }

