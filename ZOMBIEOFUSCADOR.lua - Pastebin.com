  .night-auto .header__btn { color: rgb(255, 255, 255) !important; }
  .night-auto .footer a { color: rgb(153, 153, 153); }
  .night-auto .footer a:hover { color: rgb(102, 102, 102); text-decoration: none; }
  .night-auto .header__container { background: none; }
