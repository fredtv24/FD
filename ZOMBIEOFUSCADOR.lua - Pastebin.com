  .night-auto .btn.-like.-active { background: url("/themes/pastebin/sprite/spritesheet.webp") -23px -2040.5px / 78px 3208px no-repeat rgb(139, 195, 74); border-bottom: 2px solid rgb(139, 195, 74); color: rgb(255, 255, 255); }
  .night-auto .btn.-dislike { padding-left: 22px; background: url("/themes/pastebin/sprite/spritesheet.webp") -23px -1148.5px / 78px 3208px no-repeat rgb(34, 34, 34); }
  .night-auto .btn.-dislike.-active { background: url("/themes/pastebin/sprite/spritesheet.webp") -23px -1214.5px / 78px 3208px no-repeat rgb(244, 67, 54); border-bottom: 2px solid rgb(244, 67, 54); color: rgb(255, 255, 255); }
  .night-auto input[type="checkbox"] + label > span:first-of-type { background-color: rgb(43, 43, 43); border: 1px solid rgb(34, 34, 34); }
  .night-auto .top-footer { background: rgb(43, 43, 43); }
  .night-auto .footer { background-color: rgb(37, 37, 37); color: rgb(204, 204, 204); border-top: 1px solid rgb(51, 51, 51); }
