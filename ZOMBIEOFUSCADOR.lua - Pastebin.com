  .night-auto .select2-container--classic .select2-selection--single { background-color: rgb(246, 246, 246); border: 1px solid rgb(221, 221, 221); border-radius: 4px; outline: 0px; background-image: linear-gradient(rgb(51, 51, 51) 50%, rgb(238, 238, 238)); background-repeat: repeat-x; }
  .night-auto .select2-container--classic .select2-selection--single:focus { border: 1px solid rgb(88, 151, 251); }
