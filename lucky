local function enableAntiAFK()
    -- Previne kick por inatividade
    AntiAFKConnection = player.Idled:Connect(function() -- ← CORREÇÃO: lp → player
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
